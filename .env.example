# Copie este archivo como .env para personalizar la contraseña de SQL Server en docker-compose.
# Requisitos de SQL Server: mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
# No use ";" (rompe la cadena de conexión). El archivo .env no se versiona.
MSSQL_SA_PASSWORD=CambieEstaClave#2026
