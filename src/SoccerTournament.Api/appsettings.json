{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SoccerTournament": ""
  },
  "Database": {
    "RunMigrationsOnStartup": true,
    "SeedOnStartup": true,
    "StartupMaxRetries": 10,
    "StartupRetryDelaySeconds": 5,
    "MaxRetryCount": 3,
    "CommandTimeoutSeconds": 30
  }
}
