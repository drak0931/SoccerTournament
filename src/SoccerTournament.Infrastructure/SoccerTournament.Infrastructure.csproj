<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure: implementa los contratos de Application (EF Core, Dapper, UnitOfWork, idempotencia, seed). -->
  <ItemGroup>
    <ProjectReference Include="..\SoccerTournament.Application\SoccerTournament.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="dbup-sqlserver" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <!-- Scripts de esquema versionados, embebidos para ejecutarlos con DbUp al iniciar -->
  <ItemGroup>
    <EmbeddedResource Include="Persistence\Scripts\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SoccerTournament.Infrastructure.Tests" />
  </ItemGroup>

</Project>
